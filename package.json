    "@opennextjs/cloudflare": "^1.20.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-table": "^8.21.2",
    "ai": "^4.1.45",
    "better-auth": "^1.1.21",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dataforseo-client": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.0.8",
    "htmlparser2": "^10.0.0",
    "jose": "^6.0.8",
    "lucide-react": "^0.475.0",
    "next": "^15.2.1",
    "next-themes": "^0.4.4",
    "papaparse": "^5.5.2",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.20.2",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tldts": "^6.1.77",
    "undici": "^8.13.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
