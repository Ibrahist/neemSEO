{
  "name": "neemseo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "db:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts && drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate:local": "tsx scripts/migrate-sqlite.ts",
    "db:migrate:pg": "tsx scripts/migrate-pg.ts",
    "deploy": "wrangler deploy",
    "release:notes": "node scripts/release-notes.mjs",
    "sync-plugin-skills": "node scripts/sync-plugin-skills.mjs",
    "ci:check": "node scripts/ci-check.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/react": "^4.0.184",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@opennextjs/cloudflare": "^1.20.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.179",
    "better-auth": "^1.1.21",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dataforseo-client": "^2.0.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.0.8",
    "htmlparser2": "^12.0.0",
    "jose": "^6.0.8",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.4",
    "papaparse": "^5.5.2",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.20.2",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tldts": "^7.5.5",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
