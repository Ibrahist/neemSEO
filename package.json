{
  "name": "neemseo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "db:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts && drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:local": "tsx scripts/migrate-sqlite.ts",
    "db:migrate:pg": "tsx scripts/migrate-pg.ts",
    "deploy": "wrangler deploy",
    "release:notes": "node scripts/release-notes.mjs",
    "sync-plugin-skills": "node scripts/sync-plugin-skills.mjs",
    "ci:check": "node scripts/ci-check.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/react": "^1.1.9",
    "@libsql/client": "^0.14.0",
