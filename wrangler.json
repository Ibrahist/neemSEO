{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neemseo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neemseo-db",
      "database_id": "placeholder-d1-id",
      "migrations_dir": "db/migrations/sqlite"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_STORAGE",
      "id": "placeholder-kv-id"
    }
  ],
  "env": {
    "staging": {
      "name": "neemseo-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "neemseo-db-staging",
          "database_id": "placeholder-staging-d1-id",
          "migrations_dir": "db/migrations/sqlite"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV_STORAGE",
          "id": "placeholder-staging-kv-id"
        }
      ]
    }
  }
}
