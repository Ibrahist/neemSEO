# neemSEO Environment Configuration

# App settings
NEEMSEO_ENV=development
NEEMSEO_DEBUG=true
NEEMSEO_SECRET_KEY=change-this-in-production-to-a-secure-random-string
NEEMSEO_BASE_URL=http://localhost:8000
NEEMSEO_USER_AGENT=neemSEO-Bot/1.0 (+http://localhost:8000/bot)

# Database (SQLite for local/Phase 1; PostgreSQL for production)
NEEMSEO_DATABASE_URL=sqlite:///./neemseo.db
# NEEMSEO_DATABASE_URL=postgresql+psycopg2://neemseo:neemseo@localhost:5432/neemseo

# Redis Cache & Job Queue (Optional for Phase 1)
# NEEMSEO_REDIS_URL=redis://localhost:6379/0

# Google APIs
NEEMSEO_PAGESPEED_API_KEY=
# NEEMSEO_SEARCH_CONSOLE_CLIENT_ID=
# NEEMSEO_SEARCH_CONSOLE_CLIENT_SECRET=

# Third-party SEO APIs (Bring Your Own Key)
NEEMSEO_DATAFORSEO_LOGIN=
NEEMSEO_DATAFORSEO_PASSWORD=
NEEMSEO_SERPAPI_API_KEY=
