# DataForSEO API Credentials (BYOK)
# You can provide either DATAFORSEO_LOGIN and DATAFORSEO_PASSWORD,
# or the base64-encoded DATAFORSEO_API_KEY (login:password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_API_KEY=

# Auth Mode: "local_noauth" | "cloudflare_access" | "hosted"
AUTH_MODE=local_noauth

# Cloudflare Access Configuration (required when AUTH_MODE=cloudflare_access)
TEAM_DOMAIN=
POLICY_AUD=

# Better Auth Configuration (required when AUTH_MODE=hosted and for token encryption)
BETTER_AUTH_SECRET=your-secure-32-byte-secret-key-here-for-encryption
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth & Search Console Integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenRouter API Key for in-app AI SEO agent (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Database Configuration (Docker / standalone mode)
# SQLite file path (default) or Postgres connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neemseo
SQLITE_FILE_PATH=./data/neemseo.sqlite

# Docker Self-hosting
PORT=3000
ALLOWED_HOST=0.0.0.0

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
